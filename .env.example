# Server Port
PORT=3001

# Environment (development | production)
NODE_ENV=development

# Allowed Client Origin for CORS (in development)
# In production, when Express serves Vite static build, CORS is same-origin
CLIENT_ORIGIN=http://localhost:5173

# Optional: Public URL of the deployed app (for generating shareable invite links)
# VITE_PUBLIC_URL=https://mindclash.up.railway.app

# Server-Side AI Question Generation (NEVER prefix with VITE_ or expose to client)
# Primary Provider: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Backup Provider: Groq (Llama 3.3 70B Versatile)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# AI Generation Timeouts & Guardrails (Subject to total deadline)
# AI_TOTAL_DEADLINE_MS=60000       # Complete AI preparation process deadline (default 60s)
# GEMINI_TIMEOUT_MS=30000          # Gemini attempt timeout (default 30s)
# GROQ_TIMEOUT_MS=20000            # Groq attempt timeout (default 20s)
# GROQ_RESERVED_TIME_MS=20000      # Time budget reserved for Groq failover (default 20s)
# AI_MAX_RETRIES=2                 # Bounded retries for transient failures (default 2)
# AI_MAX_CONCURRENT_BATCHES=5      # Max concurrent rooms generating AI questions

# Shared Duplicate Prevention & History Storage
# Optional: Redis connection URL for durable cross-restart duplicate prevention.
# If omitted or unreachable, defaults gracefully to bounded in-memory history without errors.
# REDIS_URL=redis://localhost:6379
# HISTORY_TTL_MS=86400000 # 24 hours in milliseconds
# RESERVATION_TTL_MS=300000 # 5 minutes in milliseconds

# Operational Limitations:
# - In-memory history is lost on server restart (Redis preserves history across restarts).
# - Recent-history protection is bounded by TTL and capacity limits.
# - Unlimited uniqueness cannot be guaranteed for infinite rounds or finite category sets.
