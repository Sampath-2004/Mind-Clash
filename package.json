{
  "name": "mind-clash",
  "version": "1.0.0",
  "description": "Real-time competitive multiplayer browser game",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build:shared": "npm run build --workspace=shared",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build": "npm run build:shared && npm run build:client && npm run build:server",
    "typecheck": "npm run typecheck --workspace=shared && npm run typecheck --workspace=server && npm run typecheck --workspace=client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test --workspace=server",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "verify:live": "node scripts/verify-live.js",
    "start": "npm run start --workspace=server"
  },
  "keywords": [
    "multiplayer",
    "game",
    "socket.io",
    "react",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}
